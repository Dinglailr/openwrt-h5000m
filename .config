# Version — APK-compatible (no ~ character); avoids ~unknown when .git absent
CONFIG_VERSION_NUMBER="24.10.0"
CONFIG_VERSION_DIST="OpenWrt"

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_hiveton_h5000m=y

# LuCI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# Hardware NAT / Flow Offload (Filogic 880 / MT7988)
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-conntrack=y

# Fan control (kmod + daemon baked in via files/)
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_kmod-hwmon-core=y

# Wi-Fi 7 (MT7996 / 802.11be — Filogic 880 built-in)
CONFIG_PACKAGE_kmod-mt76=y
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt76-connac=y
CONFIG_PACKAGE_kmod-mt7996e=y
CONFIG_PACKAGE_mt7996-firmware=y
CONFIG_PACKAGE_wpad-openssl=y

# 5G modem (QMI primary, MBIM fallback)
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_libqmi=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_umbim=y

# WireGuard VPN
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# Travel features
CONFIG_PACKAGE_travelmate=y
CONFIG_PACKAGE_luci-app-travelmate=y

# SQM / Smart Queue Management
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_sqm-scripts-extra=y
CONFIG_PACKAGE_luci-app-sqm=y

# Web terminal
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y

# BBR TCP Congestion Control
CONFIG_PACKAGE_kmod-tcp-bbr=y

# Stealth TTL — iptables TTL/HL mangling for hotspot bypass
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_kmod-ipt-ipopt=y
CONFIG_PACKAGE_ip6tables-mod-ipopt=y
CONFIG_PACKAGE_kmod-ip6tables=y

# nftables (core framework for stealth mode rules)
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_nftables=y

# eMMC filesystem tools (also in DEVICE_PACKAGES, explicit for safety)
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y

# Utilities
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_kmod-usb3=y

# Force per-device rootfs so all DEVICE_PACKAGES are bundled into the image
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# AI Router
CONFIG_PACKAGE_luci-app-airouter=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
