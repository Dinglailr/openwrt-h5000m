{
  "luci-app-xray": {
    "description": "Grant access to Xray VPN ubus control",
    "read": {
      "ubus": {
        "luci.xray": [ "status", "get_exit_ip", "list_profiles", "get_profile" ]
      }
    },
    "write": {
