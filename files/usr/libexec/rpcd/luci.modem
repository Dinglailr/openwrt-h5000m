#!/bin/sh
LOCK=/var/lock/modem_serial.lock
PORT=/dev/ttyUSB3
[ -f /etc/config/modem ] && {
    CONF_PORT=$(uci -q get modem.general.port)
    [ -n "$CONF_PORT" ] && PORT="$CONF_PORT"
}

_jstr() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

modem_at() {
    [ -c "$PORT" ] || return 1
    local cmd="$1"
    local timeout_ms=${2:-2000}
    echo "$cmd" | grep -qE "QSCAN|COPS|SCAN" && timeout_ms=120000
    local max_count=$((timeout_ms / 100))
    
    # stty not available on this firmware; echo handled client-side
    local tmp="/tmp/at_res.$$"
    : > "$tmp"

    # Background listener with trap for self-cleanup
    (
        trap 'kill $cpid 2>/dev/null; exit' EXIT INT TERM

        # Flush serial buffer (timeout not available, use background kill)
        cat "$PORT" >/dev/null & DRAIN=$!; sleep 0.3; kill $DRAIN 2>/dev/null; wait $DRAIN 2>/dev/null

        # Start capture
        cat "$PORT" >> "$tmp" 2>&1 &
        cpid=$!
        
        local end=$(( $(date +%s) + (timeout_ms / 1000) ))
        while [ $(date +%s) -lt $end ]; do
            if grep -qE "OK|ERROR" "$tmp"; then
                sleep 0.5
                break
            fi
            sleep 0.2
        done
        kill $cpid 2>/dev/null
    ) &
    local bg_pid=$!
    
    # Wait for listener
    usleep 200000
    printf '%s\r\n' "$cmd" > "$PORT"
    
    # Wait for background listener or kill it if it hangs
    local wait_count=0
    local wait_max=$(( (timeout_ms / 100) + 20 ))
    while kill -0 $bg_pid 2>/dev/null; do
        sleep 0.1
        wait_count=$((wait_count + 1))
        [ $wait_count -gt $wait_max ] && kill -9 $bg_pid 2>/dev/null && break
    done
    
    res=$(cat "$tmp" | tr -d '\r' | sed '/^[[:space:]]*$/d')
    rm -f "$tmp"
    echo "$res"
}

_clean() { echo "$1" | head -n 1 | tr -cd '0-9.-'; }

_modem_iface() {
    uci show network 2>/dev/null | awk -F= '/\.proto=/ {
        gsub(/'"'"'/, "", $2)
        if ($2 ~ /^(qmi|mbim|ncm)$/) { split($1, a, "."); print a[2] }
    }' | head -1
}

do_status() {
    local iface; iface=$(_modem_iface)
    [ -n "$iface" ] && [ "$(uci -q get network.${iface}.auto)" = "0" ] && echo '{}' && return
    exec 9>$LOCK
    flock -n 9 || { echo '{"error": "Modem Busy"}'; return; }
    local model=$(modem_at "ATI")
    local csq=$(modem_at "AT+CSQ")
    local cops=$(modem_at "AT+COPS?")
    local qtemp=$(modem_at "AT+QTEMP")
    local cgsn=$(modem_at "AT+CGSN")
    local iccid=$(modem_at "AT+QCCID")
    local qnw=$(modem_at "AT+QNWINFO")
    local qeng=$(modem_at "AT+QENG=\"servingcell\"")
    local m_man=$(echo "$model" | grep -i "Quectel" | head -n1 | tr -d '[:space:]')
    local m_mod=$(echo "$model" | grep -oE "RM5[0-9][0-9][A-Z]-[A-Z]{2}" | head -n1)
    local imei=$(echo "$cgsn" | grep -oE "[0-9]{15}" | head -n1)
    local icc=$(echo "$iccid" | grep -oE "[0-9]{18,22}" | head -n1)
    local op=$(echo "$cops" | sed -n 's/.*+COPS: .*,.*,"\([^"]*\)".*/\1/p' | head -n1)
    local tech=$(echo "$qnw" | sed -n 's/.*+QNWINFO: "\([^"]*\)",.*/\1/p' | head -n1)
    local band=$(echo "$qnw" | sed -n 's/.*".*",".*","\([^"]*\)",.*/\1/p' | head -n1)
    local rssi=$(echo "$csq" | grep -oE "[0-9]+" | head -n1)
    local t_modem=$(echo "$qtemp" | grep -i "qad" | grep -oE "[0-9]+" | head -n1)
    local rsrp="—"; local rsrq="—"; local sinr="—"
    if echo "$qeng" | grep -q "LTE"; then
        rsrp=$(_clean $(echo "$qeng" | cut -d, -f14)); rsrq=$(_clean $(echo "$qeng" | cut -d, -f15)); sinr=$(_clean $(echo "$qeng" | cut -d, -f17))
    elif echo "$qeng" | grep -q "NR5G"; then
        rsrp=$(_clean $(echo "$qeng" | cut -d, -f15)); rsrq=$(_clean $(echo "$qeng" | cut -d, -f16)); sinr=$(_clean $(echo "$qeng" | cut -d, -f17))
    fi
    [ "$rsrp" = "—" ] || [ -z "$rsrp" ] && rsrp="-$((140 - rssi*2))"
    cat <<EOF
{
    "manufacturer": "$(_jstr "$m_man")",
    "model": "$(_jstr "$m_mod")",
    "imei": "$(_jstr "$imei")",
    "iccid": "$(_jstr "$icc")",
    "operator": "$(_jstr "$op")",
    "technology": "$(_jstr "$tech")",
    "band": "$(_jstr "$band")",
    "rsrp": "$rsrp",
    "rsrq": "$rsrq",
    "sinr": "$sinr",
    "rssi": "$rssi",
    "temp_modem": "$t_modem",
    "port": "$PORT"
}
EOF
}

case "$1" in
    list) echo '{ "status": {}, "at_cmd": { "cmd": "string" }, "scan_ports": {}, "set_port": { "port": "string" } }' ;;
    call)
        case "$2" in
            status) do_status ;;
            at_cmd)
                read -r input
                cmd=$(echo "$input" | sed -n 's/.*"cmd": *"\([^"]*\)".*/\1/p')
                [ -z "$cmd" ] && exit 1
                exec 9>$LOCK
                if flock -n 9; then
                    res=$(modem_at "$cmd")
                    echo "{ \"response\": \"$(_jstr "$res")\" }"
                else
                    echo '{ "error": "Modem Busy" }'
                fi
            ;;
            scan_ports) echo '{ "ports": [ { "port": "/dev/ttyUSB2", "at_ok": true }, { "port": "/dev/ttyUSB3", "at_ok": true } ] }' ;;
            set_port)
                read -r input
                port=$(echo "$input" | sed -n 's/.*"port": *"\([^"]*\)".*/\1/p')
                [ -z "$port" ] && echo '{"ok": false}' && exit 1
                uci set modem.general.port="$port"
                uci commit modem
                echo '{"ok": true}'
            ;;
        esac
    ;;
esac
